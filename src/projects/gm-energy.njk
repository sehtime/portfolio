<script>
(function(){
  var PASSWORD = "sunday", KEY = "hems-gate";
  var art = document.getElementById('hems-gate-target');
  var bB = document.getElementById('vt-brief'), bF = document.getElementById('vt-full');
  var gate = document.getElementById('hems-gate');
  var pw = document.getElementById('hems-pw'), err = document.getElementById('hems-err'), go = document.getElementById('hems-go');
  if(!art || !bB) return;
  function setView(full){
    art.classList.toggle('case--brief', !full);
    bB.classList.toggle('on', !full); bF.classList.toggle('on', full);
    bB.setAttribute('aria-selected', !full); bF.setAttribute('aria-selected', full);
    gate.classList.remove('open'); err.textContent = '';
  }
  bB.addEventListener('click', function(){ setView(false); });
  bF.addEventListener('click', function(){
    if(sessionStorage.getItem(KEY) === '1'){ setView(true); }
    else { gate.classList.add('open'); pw.focus(); }
  });
  function tryUnlock(){
    if(pw.value === PASSWORD){
      sessionStorage.setItem(KEY, '1');
      pw.value = '';
      setView(true);
    } else {
      err.textContent = 'Incorrect password';
      pw.value = ''; pw.focus();
    }
  }
  go.addEventListener('click', tryUnlock);
  pw.addEventListener('keydown', function(e){ if(e.key === 'Enter') tryUnlock(); });

  // Local-preview convenience: once unlocked, a reload shouldn't drop you back
  // to Brief or lose your place. sessionStorage is per-tab and clears with it.
  // Stripped from production along with the rest of the gate.
  if(sessionStorage.getItem(KEY) === '1') setView(true);
  var SPOS = 'hems-scroll', saveTimer;
  var savePos = function(){ sessionStorage.setItem(SPOS, String(window.scrollY)); };
  // save continuously, not just on unload — a live-reload may not fire beforeunload
  window.addEventListener('scroll', function(){
    clearTimeout(saveTimer); saveTimer = setTimeout(savePos, 150);
  }, {passive:true});
  window.addEventListener('beforeunload', savePos);
  var y = parseInt(sessionStorage.getItem(SPOS) || '0', 10);
  if(y > 8){
    if('scrollRestoration' in history) history.scrollRestoration = 'manual';
    var tries = 0;
    var restore = function(){
      window.scrollTo(0, y);
      // lazy images keep growing the page, so keep trying until it lands
      if(++tries < 14 && Math.abs(window.scrollY - y) > 4) setTimeout(restore, 120);
    };
    window.addEventListener('load', function(){ setTimeout(restore, 60); });
  }
})();
(function(){
  var rail = document.querySelector('.part-rail');
  var art = document.getElementById('hems-gate-target');
  if(!rail || !art || !('IntersectionObserver' in window)) return;
  var links = [].slice.call(rail.querySelectorAll('a'));
  var targets = links.map(function(a){ return document.querySelector(a.getAttribute('href')); });
  function showHide(){
    var full = !art.classList.contains('case--brief');
    var past = window.scrollY > 500;
    rail.classList.toggle('on', full && past);
  }
  window.addEventListener('scroll', showHide, {passive:true});
  document.addEventListener('click', function(e){ if(e.target.closest('.vt-btn')) setTimeout(showHide, 60); });
  showHide();
  function mark(){
    var mid = window.scrollY + window.innerHeight * 0.35;
    var idx = -1;
    targets.forEach(function(t,i){ if(t && t.offsetTop <= mid) idx = i; });
    links.forEach(function(a,i){ a.classList.toggle('cur', i === idx); });
  }
  window.addEventListener('scroll', mark, {passive:true});
  window.addEventListener('resize', mark);
  mark();
})();
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = [].slice.call(document.querySelectorAll('#genie-shot, .lg-drift'));
  els.forEach(function(el){
    var paused = false, dir = 1, pos = 0;
    el.addEventListener('mouseenter', function(){ paused = true; });
    el.addEventListener('mouseleave', function(){ paused = false; });
    el.addEventListener('touchstart', function(){ paused = true; }, {passive:true});
    setInterval(function(){
      if (paused) return;
      var max = el.scrollHeight - el.clientHeight;
      if (max <= 0) return;
      // Pace by scroll range, not a fixed step, so a shorter or taller image
      // still takes ~28s to traverse. (25 ticks/s x 28s = 700.)
      // Track position as a float: assigning scrollTop += a sub-pixel value
      // gets rounded away and the drift stalls.
      if (Math.abs(pos - el.scrollTop) > 2) pos = el.scrollTop;  // user scrolled — resync
      pos += dir * (max / 700);
      if (pos >= max) { pos = max; dir = -1; }
      if (pos <= 0) { pos = 0; dir = 1; }
      el.scrollTop = pos;
    }, 40);
  });
})();
(function(){
  var tabs = document.querySelectorAll('.evo-tab');
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      tabs.forEach(function(x){ x.classList.toggle('on', x === t); });
      document.querySelectorAll('.evo-grid').forEach(function(g){
        g.classList.toggle('on', g.id === 'evo-' + t.dataset.evo);
      });
    });
  });
})();
</script>

