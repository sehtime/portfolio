  (function(){
    var wrap = document.getElementById('pmoverview-wrap');
    var modal = document.getElementById('pmmodal');
    var modalImg = document.getElementById('pmmodal-img');
    var chips = document.querySelectorAll('#pmlegend .pchip');
    var data = {
      tom: { src: '/assets/img/journey-map-diagrams/tom-detailed.webp', alt: "Tom's detailed EV Journey — starting in the EV Journey, transitioning into the Home Integrated Journey" },
      markus: { src: '/assets/img/journey-map-diagrams/markus-detailed.webp', alt: "Markus's detailed Home Integrated Journey — starting in the HEMS Journey, transitioning into the EV Journey" },
      rhonda: { src: '/assets/img/journey-map-diagrams/rhonda-detailed.webp', alt: "Rhonda's detailed Home Integrated Journey — HEMS only, start to finish" },
      fiona: { src: '/assets/img/journey-map-diagrams/fiona-detailed.webp', alt: "Fiona's detailed EV & HEMS Combined Journey" }
    };
    var cur = null;
    function set(p){
      var d = p && data[p];
      if(d){
        modalImg.setAttribute('src', d.src);
        modalImg.setAttribute('alt', d.alt);
        modal.classList.add('show');
        wrap.classList.add('dimmed');
      } else {
        modal.classList.remove('show');
        wrap.classList.remove('dimmed');
      }
      chips.forEach(function(c){ c.classList.toggle('on', c.dataset.p === p); });
      cur = p;
    }
    chips.forEach(function(c){
      c.addEventListener('mouseenter', function(){ set(c.dataset.p); });
      c.addEventListener('mouseleave', function(){ if(cur === c.dataset.p && !c.classList.contains('lock')) set(null); });
      c.addEventListener('click', function(){
        var lock = c.classList.contains('lock');
        chips.forEach(function(x){ x.classList.remove('lock'); });
        if(!lock){ c.classList.add('lock'); set(c.dataset.p); } else { set(null); }
      });
    });
  })();
