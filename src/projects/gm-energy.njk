  .tcard .shot img{width:100%;height:100%;object-fit:cover;object-position:top;transition:object-position 7s ease}
  .tcard:hover .shot img{object-position:bottom}
  .tcard .shot--scroll{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
  .tcard .shot--scroll img{width:100%;height:auto;object-fit:unset;object-position:unset;transition:none}
