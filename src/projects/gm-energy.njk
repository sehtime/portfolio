  .lg-afford{width:min(1000px,94vw);margin:26px 0 -12px 50%;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;gap:10px;font-family:var(--serif);font-style:italic;font-size:13px;color:var(--muted)}
