<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css" />
<!-- Cloudflare Web Analytics — cookieless, no consent banner needed. Manual
     snippet because the domain is DNS-only on Cloudflare, so automatic
     injection never runs. Token is public by design. -->
<script defer type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3056599aa5794768a894280777c6f506"}'></script>
<!-- Umami — cookieless too; runs alongside Cloudflare for city-level geography
     and per-page detail. Website id is public by design. -->
<script defer src="https://cloud.umami.is/script.js" data-website-id="5c36f0bd-8072-4b04-8fc0-d58cf10511c3" data-domains="sehyoung.com"></script>
{% if extraStyle %}{{ extraStyle | safe }}{% endif %}
