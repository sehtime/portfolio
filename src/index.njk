{% import "partials/project-card.njk" as cards with context %}
<!-- ============ LIGHT HALF — UX ============ -->
<header class="hero wrap hero--split">
  <div>
    <span class="eyebrow">UX/Product/Industrial Designer</span>
    <h1>Designing <span class="em">clear</span>, human experiences for <span class="em">complex</span> problems.</h1>
    <p class="lead">I'm Seh — a designer who moves between digital product and industrial design, solving complex problems with simple, effective solutions and connecting people with beautiful experiences.</p>
  </div>
  <aside class="hero-side" aria-label="At a glance">
    <dl>
      <div><dt>Experience</dt><dd>Merkle · Shell · Softway · Advent · Tramontina</dd></div>
      <div><dt>Based in</dt><dd>Houston, TX</dd></div>
      <div><dt>Focus</dt><dd>UX · Strategy · Product · Industrial Design</dd></div>
    </dl>
  </aside>
</header>

<section class="wrap" style="padding-bottom:clamp(72px,11vw,120px)">
  <div class="sec-head">
    <h2>UX case studies</h2>
    <span class="kicker">05 projects</span>
  </div>
