      <div class="feature-body">
        <span class="kicker" style="color:var(--accent)">Featured · Experience Lead</span>
        <h3>HEMS eCommerce</h3>
        <p>Leading the end-to-end shopping and checkout experience for GM Energy's home energy hardware — from ecosystem mapping to a shipped storefront.</p>
        <div class="cap">Service Design · Zero to One</div>
        <span class="num">— 01 <span class="go">Read case study →</span></span>
      </div>
    </div>
  {% endcall %}
  <div class="grid grid--support">
    {% call cards.projectCard("shell-pricing") %}
      <div class="thumb kb"><img src="/assets/img/shell-supply-demand.jpg" alt="Pricing Excellence Tool — Supply &amp; Demand module" loading="lazy" style="object-position:center"><span class="draft-badge">In progress</span></div>
      <h3>Pricing Tool</h3>
      <div class="cap">Enterprise · Product Design</div>
      <span class="num">— 02</span>
    {% endcall %}
    {% call cards.projectCard("site-optimization") %}
      <div class="thumb"><img src="/assets/img/archive/1551295053007-preview-image.png" alt="Site Optimization cover" loading="lazy"></div>
