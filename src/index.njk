    <div class="sec-head">
      <h2>Industrial design</h2>
      <span class="kicker">04 projects · Industrial Designer</span>
    </div>
    <p class="lead" style="max-width:56ch;margin:-6px 0 34px;font-size:15px">From sketch to manufacturing — objects built for how people actually use them. This foundation shapes how I approach digital product today.</p>
    <div class="grid">
      {% call cards.projectCard("exhibit-design") %}<div class="thumb kb"><img src="/assets/img/archive/1497300911420-Exhibit-Design-Cover-copy.jpg" alt="Exhibit Design cover" loading="lazy"></div><h3>Exhibit Design</h3><div class="cap">Advent</div>{% endcall %}
      {% call cards.projectCard("kitchen-shears") %}<div class="thumb kb"><img src="/assets/img/kitchen-shears/tesoura-thumb.jpg" alt="Kitchen Shears cover" loading="lazy"></div><h3>Kitchen Shears</h3><div class="cap">Tramontina</div>{% endcall %}
      {% call cards.projectCard("nesting-mixing-bowls") %}<div class="thumb kb"><img src="/assets/img/mixing-bowls/nested-top-view.jpg" alt="Nesting Mixing Bowls cover" loading="lazy"></div><h3>Nesting Mixing Bowls</h3><div class="cap">Tramontina</div>{% endcall %}
      {% call cards.projectCard("lifeline") %}<div class="thumb kb"><img src="/assets/img/lifeline/board-01.webp" alt="Lifeline cover" loading="lazy"></div><h3>Lifeline</h3><div class="cap">Thesis</div>{% endcall %}
