      <div class="cap">UX Research · Conversion</div>
      <span class="num">— 03</span>
    {% endcall %}
    {% call cards.projectCard("content-curation") %}
      <div class="thumb kb"><img src="/assets/img/archive/1551290201401-Screen-Shot-2019-02-27-at-11.53.57-AM.jpg" alt="Content Curation cover" loading="lazy"></div>
      <h3>Content Curation</h3>
      <div class="cap">Product · Content Strategy</div>
      <span class="num">— 04</span>
    {% endcall %}
    {% call cards.projectCard("soundcloud") %}
      <div class="thumb kb"><img src="/assets/img/archive/1551247512422-DSC_0749.JPG" alt="Visual / Interaction cover" loading="lazy"></div>
      <h3>Visual / Interaction</h3>
      <div class="cap">Soundcloud Mobile App Re-Design</div>
      <span class="num">— 05</span>
    {% endcall %}
    {% if emit.enabled %}
    {% call cards.projectCard("inside-emit") %}
      <div class="thumb kb"><img src="/assets/img/emit/home.webp" alt="Inside EMIT cover" loading="lazy"></div>
      <h3>Inside EMIT</h3>
      <div class="cap">UX Strategy · Internal Comms</div>
      <span class="num">— 06</span>
    {% endcall %}
    {% endif %}
